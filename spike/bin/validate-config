#!/bin/sh
# M2 money test: real Frigate parses a real config under strict confinement.
set -e
# M7: cfg_get + detector_sed (render-once detector selection identical to frigate-run).
. "$SNAP/bin/lib-wait.sh"
export FRIGATE_CONFIG_DIR="$SNAP_DATA/config"
export FRIGATE_BASE_DIR="$SNAP_COMMON/media/frigate"
export FRIGATE_CACHE_DIR="/tmp/cache"
export CONFIG_FILE="$SNAP_DATA/config/config.yml"
export DEFAULT_FFMPEG_VERSION="7.0"
export INCLUDED_FFMPEG_VERSIONS="8.0:7.0:5.0"
# cv2 needs libGL.so.1 from the mesa-2604 content mount (gpu/cleanup strips it from
# the snap prime — Task 10 finding; svc-c precedent for non-gpu-extension apps).
MESA_LIB="$SNAP/gpu-2604/mesa-2604/usr/lib/x86_64-linux-gnu"
# if-form, not '[ ] &&': set -e would abort when the content mount is absent
if [ -d "$MESA_LIB" ]; then export LD_LIBRARY_PATH="$MESA_LIB:${LD_LIBRARY_PATH:-}"; fi
mkdir -p "$SNAP_DATA/config" "$SNAP_COMMON/media/frigate" /tmp/cache
# Same conditional livecam render as frigate-run (see frigate-config.yml LIVECAM block docs).
# Hardening (identical to frigate-run): umask 077 render; non-secret tokens via sed; the secret
# __LIVECAM_URL__ via a staged-python literal str.replace that reads the URL from the FILE (never an
# argv). Literal replace means '|', '&', '\' in credentials are legal (the old sed -f limitation is
# retired).
if [ ! -f "$CONFIG_FILE" ]; then
    umask 077
    # M7 detector render — same helper/logic as frigate-run (keep active block, delete others).
    DET_SED=$(detector_sed)
    # grep tests presence AND non-whitespace content without reading the URL into a shell variable.
    if grep -q '[^[:space:]]' "$SNAP_COMMON/livecam-url" 2>/dev/null; then
        sed -e "s|__SNAP_COMMON__|$SNAP_COMMON|g" -e "s|__SNAP__|$SNAP|g" -e "$DET_SED" \
            "$SNAP/config/frigate-config.yml" > "$CONFIG_FILE"
        # Literal-safe secret substitution: URL read from the file (never argv), str.replace.
        # In-place rewrite of $CONFIG_FILE (already 0600; python open("w") preserves the mode).
        "$SNAP/usr/bin/python3.11" - "$CONFIG_FILE" "$SNAP_COMMON/livecam-url" <<'EOF'
import sys
cfg = open(sys.argv[1]).read()
url = open(sys.argv[2]).read().strip()
open(sys.argv[1], "w").write(cfg.replace("__LIVECAM_URL__", url))
EOF
    else
        sed -e "s|__SNAP_COMMON__|$SNAP_COMMON|g" -e "s|__SNAP__|$SNAP|g" -e "$DET_SED" \
            -e '/# LIVECAM-BEGIN/,/# LIVECAM-END/d' \
            "$SNAP/config/frigate-config.yml" > "$CONFIG_FILE"
    fi
    umask 022
fi
cd /opt/frigate   # through the Task-2 layout: also proves the layout works end-to-end
exec "$SNAP/usr/bin/python3.11" -u -m frigate --validate-config
