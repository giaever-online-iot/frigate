#!/bin/sh
# M2 money test: real Frigate parses a real config under strict confinement.
set -e
export FRIGATE_CONFIG_DIR="$SNAP_DATA/config"
export FRIGATE_BASE_DIR="$SNAP_COMMON/media/frigate"
export FRIGATE_CACHE_DIR="/tmp/cache"
export CONFIG_FILE="$SNAP_DATA/config/config.yml"
export DEFAULT_FFMPEG_VERSION="7.0"
export INCLUDED_FFMPEG_VERSIONS="8.0:7.0:5.0"
# cv2 needs libGL.so.1 from the mesa-2604 content mount (gpu/cleanup strips it from
# the snap prime — Task 10 finding; svc-c precedent for non-gpu-extension apps).
MESA_LIB="$SNAP/gpu-2604/mesa-2604/usr/lib/x86_64-linux-gnu"
# if-form, not '[ ] &&': set -e would abort when the content mount is absent
if [ -d "$MESA_LIB" ]; then export LD_LIBRARY_PATH="$MESA_LIB:${LD_LIBRARY_PATH:-}"; fi
mkdir -p "$SNAP_DATA/config" "$SNAP_COMMON/media/frigate" /tmp/cache
[ -f "$CONFIG_FILE" ] || sed -e "s|__SNAP_COMMON__|$SNAP_COMMON|g" -e "s|__SNAP__|$SNAP|g" \
    "$SNAP/config/frigate-config.yml" > "$CONFIG_FILE"
cd /opt/frigate   # through the Task-2 layout: also proves the layout works end-to-end
exec "$SNAP/usr/bin/python3.11" -u -m frigate --validate-config
