#!/bin/sh
# Add mesa-2604 GPU lib path: gpu/cleanup removes libGL.so.1 from snap prime (Task 10 finding).
# The content interface is auto-connected at install time, so this path exists at daemon start.
MESA_LIB="$SNAP/gpu-2604/mesa-2604/usr/lib/x86_64-linux-gnu"
[ -d "$MESA_LIB" ] && export LD_LIBRARY_PATH="$MESA_LIB:${LD_LIBRARY_PATH:-}"
. "$SNAP/bin/lib-wait.sh"
# Readiness gate: block until go2rtc answers (or 60s), record the wait as evidence.
wait_for_url "http://127.0.0.1:1984/api/streams" 60 || true
export SPIKE_WAITED_MS="${WAITED_MS:--1}"
exec "$SNAP/usr/bin/python3.11" "$SNAP/probes/svc.py" svc-a
