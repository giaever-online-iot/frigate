#!/bin/sh
# M3: the Frigate daemon under strict confinement.
set -e
. "$SNAP/bin/lib-wait.sh"

export FRIGATE_CONFIG_DIR="$SNAP_DATA/config"
export FRIGATE_BASE_DIR="$SNAP_COMMON/media/frigate"
export FRIGATE_CACHE_DIR="/tmp/cache"
export CONFIG_FILE="$SNAP_DATA/config/config.yml"
export DEFAULT_FFMPEG_VERSION="7.0"
export INCLUDED_FFMPEG_VERSIONS="7.0:5.0"

mkdir -p "$SNAP_DATA/config" "$SNAP_COMMON/media/frigate" "$SNAP_COMMON/db" /tmp/cache
# Cache is staging-only and safe to clear at daemon start; stale segments from removed
# cameras crash the recording maintainer (KeyError, observed M4 Task 4); private tmp
# outlives even snap remove --purge. Also safe on restarts: frigate re-stages in-flight
# segments; recording loses at most the segment being staged at crash time.
rm -rf -- "${FRIGATE_CACHE_DIR:?}"/*

# Stale-SHM clear (M6 finding: model-geometry SHM persists across restarts and crashes
# every detect process on geometry change - "buffer is too small for requested array").
# DENYLIST policy: preserve python-mp names (psm_*, sem.*), delete everything else in the
# snap's private /dev/shm (camera-derived segment names are unpredictable; an allowlist is
# impractical). Sibling daemons write nothing here (M6 final-review inventory: go2rtc=Go
# no shm files, nginx=anonymous mmap, certsync=shell). ASSUMPTION recorded: if frigate ever
# moves geometry-dependent data into a psm_* segment, this clear silently stops covering it.
for _shm in /dev/shm/*; do
    case "${_shm##*/}" in
        psm_*|sem.*) ;;
        *) rm -f "$_shm" 2>/dev/null || true ;;
    esac
done

# Fix 3 (PR#3): satisfy the paths Frigate's /logs API reads. frigate.api.app serves
# /logs/{frigate,go2rtc,nginx} from the FIXED upstream s6-log paths /dev/shm/logs/<svc>/current.
# The snap has no s6 logging, so those files were absent and the API 500'd -> the Web UI /logs
# page crashed (undefined.length). We create them HERE (not in nginx-run) because /dev/shm is
# shared across the snap's apps but ONLY apps with shm-private (frigate, validate-config) may
# write arbitrary /dev/shm paths — nginx's write is AppArmor-denied. Runs AFTER the shm-clear
# above (the clear's top-level glob can't rm a directory, so this structure also survives frigate
# restarts). LEAN variant: nginx/current is a symlink to the real error.log (zero duplication,
# real content); frigate/go2rtc/current are empty placeholders so those tabs render empty instead
# of 500ing. Full stdout tee (real frigate/go2rtc logs) is deferred: POSIX sh lacks pipefail, so
# `exec daemon | tee` would break crash-exit propagation for the on-failure go2rtc service.
# Authoritative logs stay `snap logs -f frigate.frigate` / journalctl (see README).
mkdir -p /dev/shm/logs/frigate /dev/shm/logs/go2rtc /dev/shm/logs/nginx
ln -sf "$SNAP_DATA/nginx/logs/error.log" /dev/shm/logs/nginx/current
[ -e /dev/shm/logs/frigate/current ] || : > /dev/shm/logs/frigate/current
[ -e /dev/shm/logs/go2rtc/current ] || : > /dev/shm/logs/go2rtc/current

# Render config at FIRST start only — once config.yml exists, the OPERATOR owns it
# (docs/accelerator-support.md instructs editing it, e.g. the Coral detector swap;
# render-every-start clobbered operator edits — M6 gate discovery). Delete config.yml and
# restart to regenerate from the template (this is also how the harness re-arms livecam after
# restoring livecam-url).
# Live camera: $SNAP_COMMON/livecam-url (0600, single-line stream URL) arms the LIVECAM block;
# absent/blank => the marker-delimited block is stripped. URL never logged. Hardening: umask 077
# (config never transiently world-readable). Non-secret tokens (__SNAP_COMMON__, __SNAP__, detector
# markers, LIVECAM strip) are rendered by sed; the secret __LIVECAM_URL__ is substituted by a staged-
# python literal str.replace that reads the URL from the FILE (never an argv → never in
# /proc/<pid>/cmdline). Literal replace means '|', '&', '\' in credentials are now legal — the old
# `sed -f <0600 script>` machinery and its metacharacter limitation are retired.
if [ ! -f "$CONFIG_FILE" ]; then
    umask 077
    # M7 detector render (render-time only; render-once guard unchanged): keep the active
    # detector block, delete the other two. Computed once, applied in both livecam branches.
    DET_SED=$(detector_sed)
    # grep tests presence AND non-whitespace content without ever reading the URL into a shell
    # variable (defence in depth: the credential lives only in the file and the python heredoc).
    if grep -q '[^[:space:]]' "$SNAP_COMMON/livecam-url" 2>/dev/null; then
        # Non-secret tokens + detector selection via sed; the LIVECAM block is KEPT (markers stay).
        sed -e "s|__SNAP_COMMON__|$SNAP_COMMON|g" -e "s|__SNAP__|$SNAP|g" -e "$DET_SED" \
            "$SNAP/config/frigate-config.yml" > "$CONFIG_FILE"
        # Literal-safe secret substitution: URL read from the file (never argv), str.replace (no sed
        # metacharacter hazard). In-place rewrite of $CONFIG_FILE (created 0600 by the sed above;
        # python open("w") truncates without chmod, so the mode is preserved).
        "$SNAP/usr/bin/python3.11" - "$CONFIG_FILE" "$SNAP_COMMON/livecam-url" <<'EOF'
import sys
cfg = open(sys.argv[1]).read()
url = open(sys.argv[2]).read().strip()
open(sys.argv[1], "w").write(cfg.replace("__LIVECAM_URL__", url))
EOF
        echo "frigate-run: livecam armed (url redacted)"
    else
        sed -e "s|__SNAP_COMMON__|$SNAP_COMMON|g" -e "s|__SNAP__|$SNAP|g" -e "$DET_SED" \
            -e '/# LIVECAM-BEGIN/,/# LIVECAM-END/d' \
            "$SNAP/config/frigate-config.yml" > "$CONFIG_FILE"
    fi
    umask 022
fi

# Readiness gate on go2rtc (provider-answered, not just unit-started)
wait_for_url "http://127.0.0.1:1984/api/streams" 60 || true
echo "frigate-run: go2rtc gate waited_ms=${WAITED_MS:--1}"

# CUR_VERSION computed once; used by both the restore block and the sidecar write below.
CUR_VERSION=$(sed -n 's/^VERSION *= *"\([^"+-]*\).*/\1/p' "$SNAP/opt/frigate/frigate/version.py" | head -1)
CUR_VERSION="${CUR_VERSION:-0.17.2}"
# Downgrade-restore: if the DB was last written by a NEWER frigate than this code,
# a migration may have advanced the schema - restore the newest backup instead.
SIDECAR="$SNAP_COMMON/db/.last-writer"
if [ -f "$SIDECAR" ]; then
    LAST_VERSION=$(awk '{print $1}' "$SIDECAR")
    NEWEST=$(printf '%s\n%s\n' "$LAST_VERSION" "$CUR_VERSION" | sort -V | tail -1)
    if [ "$NEWEST" = "$LAST_VERSION" ] && [ "$LAST_VERSION" != "$CUR_VERSION" ]; then
        echo "frigate-run: DOWNGRADE detected (db last written by $LAST_VERSION, code is $CUR_VERSION)"
        # Pick the newest backup whose schema is COMPATIBLE with this code: iterate names
        # descending (sort -V -r) and take the first stamped frigate-pre-<ver>-r<rev>.db whose
        # <ver> <= CUR_VERSION (same sort -V pair-compare idiom as the sidecar above:
        # max(<ver>,CUR)==CUR ⟺ <ver> <= CUR). A NEWER-than-code backup would carry the same
        # advanced schema we are trying to escape, so it is skipped. Legacy unstamped
        # frigate-pre-<rev>.db files (pre-M7) carry no version to check → treated as COMPATIBLE-
        # LAST: used only as a fallback when no stamped-compatible backup exists (newest legacy).
        BACKUP=""
        LEGACY_FALLBACK=""
        for _bk in $(ls -1 "$SNAP_COMMON/db/backups"/frigate-pre-*.db 2>/dev/null | sort -V -r); do
            _name="${_bk##*/}"
            case "$_name" in
                frigate-pre-*-r*.db)
                    _rest="${_name#frigate-pre-}"     # <ver>-r<rev>.db
                    _ver="${_rest%-r*}"               # <ver>
                    _max=$(printf '%s\n%s\n' "$_ver" "$CUR_VERSION" | sort -V | tail -1)
                    if [ "$_max" = "$CUR_VERSION" ]; then BACKUP="$_bk"; break; fi
                    ;;
                *)
                    [ -z "$LEGACY_FALLBACK" ] && LEGACY_FALLBACK="$_bk"
                    ;;
            esac
        done
        [ -z "$BACKUP" ] && BACKUP="$LEGACY_FALLBACK"
        if [ -n "$BACKUP" ]; then
            TS=$(date +%s)
            mv "$SNAP_COMMON/db/frigate.db" "$SNAP_COMMON/db/frigate.db.incompatible-$TS" 2>/dev/null || true
            if cp "$BACKUP" "$SNAP_COMMON/db/frigate.db"; then
                echo "frigate-run: restored $BACKUP (incompatible db preserved as frigate.db.incompatible-$TS)"
            else
                echo "frigate-run: ERROR restore cp failed - attempting to move the incompatible db back"
                mv "$SNAP_COMMON/db/frigate.db.incompatible-$TS" "$SNAP_COMMON/db/frigate.db" 2>/dev/null || \
                  echo "frigate-run: WARNING no database present - frigate will create a fresh one"
            fi
        else
            echo "frigate-run: WARNING no backup available - proceeding with the newer-schema db"
        fi
    fi
fi
printf '%s %s\n' "$CUR_VERSION" "$SNAP_REVISION" > "$SNAP_COMMON/db/.last-writer"

cd /opt/frigate
exec "$SNAP/usr/bin/python3.11" -u -m frigate
