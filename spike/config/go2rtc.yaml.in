# M1 static config — rendered by bin/go2rtc-run (__SNAP__ -> $SNAP).
# Frigate's create_config.py replaces this in M3.
log:
  level: info
api:
  # Loopback-only: go2rtc control API/UI must not be an anonymous LAN surface.
  # Controller ruling (final-review): extends the loopback principle that already
  # binds :5000/:5001. Browsers reach go2rtc via nginx's authed /live/* proxy;
  # frigate + nginx consume it via loopback. Media ports 8554/8555 are unchanged.
  # User may override to ":1984" to expose the go2rtc UI directly on LAN.
  listen: "127.0.0.1:1984"
rtsp:
  listen: ":8554"
webrtc:
  listen: ":8555"
streams:
  # Synthetic camera: staged ffmpeg pushes lavfi testsrc2 as H.264 RTSP.
  # Also proves go2rtc can spawn ffmpeg subprocesses under strict confinement.
  test: exec:__SNAP__/usr/lib/ffmpeg/8.0/bin/ffmpeg -re -f lavfi -i testsrc2=size=1280x720:rate=15 -c:v libx264 -preset veryfast -tune zerolatency -g 30 -f rtsp {output}
  # Real-object clip: CC0 pedestrian footage (Neuhauser Str., Munich). Loops forever.
  # testclip.mp4 is h264/MP4 (pre-converted from the CC0 WebM source - see spike/LICENSE-testclip for provenance + hashes).
  testclip: exec:__SNAP__/usr/lib/ffmpeg/7.0/bin/ffmpeg -re -stream_loop -1 -i __SNAP__/media-samples/testclip.mp4 -c:v libx264 -preset veryfast -tune zerolatency -g 30 -an -f rtsp {output}
