#!/bin/sh
# Consistent DB snapshot before every refresh (sqlite backup API - the daemon may be mid-write).
set -e
DB="$SNAP_COMMON/db/frigate.db"
if [ ! -f "$DB" ]; then echo "pre-refresh: no db, nothing to back up"; exit 0; fi
mkdir -p "$SNAP_COMMON/db/backups"
DEST="$SNAP_COMMON/db/backups/frigate-pre-${SNAP_REVISION}.db"
"$SNAP/usr/bin/python3.11" - "$DB" "$DEST" <<'EOF'
import sqlite3, sys
src = sqlite3.connect(sys.argv[1])
dst = sqlite3.connect(sys.argv[2])
with dst:
    src.backup(dst)
dst.close(); src.close()
EOF
MSG="pre-refresh: backed up $DB -> $DEST"
echo "$MSG"
echo "$MSG" >> "$SNAP_COMMON/db/backups/hook.log"
# retention: keep newest 2 (version-sort for determinism when mtimes tie)
ls -1 "$SNAP_COMMON/db/backups"/frigate-pre-*.db 2>/dev/null | sort -V | head -n -2 | xargs -r rm -f
# retention: keep hook.log bounded (one line per refresh would otherwise grow forever)
if [ -f "$SNAP_COMMON/db/backups/hook.log" ]; then
    tail -n 100 "$SNAP_COMMON/db/backups/hook.log" > "$SNAP_COMMON/db/backups/hook.log.tmp" \
      && mv "$SNAP_COMMON/db/backups/hook.log.tmp" "$SNAP_COMMON/db/backups/hook.log"
fi
