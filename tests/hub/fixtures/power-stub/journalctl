#!/bin/sh
# Fake journalctl for power-check.test.sh (run by fixtures/power-responder.sh, first on PATH). It parses its own argv
# and answers only the two forms tests/hub/power-check.sh must send; every call's argv goes to $STUB_ST/jargs.
#   _TRANSPORT=kernel --since @E --no-pager -q -o cat           the kernel stream since E (all boots): ordinary kernel
#       lines, one real-shaped "Linux version" line per boot (PC_BOOTS) and PC_UV "Undervoltage detected!" lines;
#       PC_KRC=1: fails (rc 1); PC_GARBLE=1: binary garbage, no lines.
#   _TRANSPORT=kernel --until @E -r -n 1 --no-pager -q -o short-unix   the reach-back proof ON THE KERNEL STREAM: one
#       entry older than E when PC_COVER=1 (default), none when 0; PC_GARBLE=1: three lines (-n 1 not honoured).
# Any other form (journalctl -k, -b, a cover query without _TRANSPORT=kernel or with --since) prints nothing, rc 0.
printf '%s\n' "$*" >> "${STUB_ST:?}/jargs"
tr=""; since=""; until=""; rev=0; n=""; out=""; other=0
while [ $# -gt 0 ]; do
  case "$1" in
    _TRANSPORT=*) tr=${1#_TRANSPORT=}; shift ;;
    --since) since=$2; shift 2 ;;
    --until) until=$2; shift 2 ;;
    -r) rev=1; shift ;;
    -n) n=$2; shift 2 ;;
    -o) out=$2; shift 2 ;;
    --no-pager|-q) shift ;;
    *) other=1; shift ;;
  esac
done
[ "$other" = 0 ] && [ "$tr" = kernel ] || exit 0
case "$since$until" in @[0-9]*) ;; *) exit 0 ;; esac
if [ -n "$since" ] && [ -z "$until" ] && [ "$rev" = 0 ] && [ -z "$n" ] && [ "$out" = cat ]; then
  [ "${PC_KRC:-0}" = 1 ] && { echo "Failed to open journal: Permission denied" >&2; exit 1; }
  [ "${PC_GARBLE:-0}" = 1 ] && { printf '\377\376\000\033[2J\001'; exit 0; }
  b=0; u=0
  while [ "$b" -lt "${PC_BOOTS:-0}" ]; do
    echo "Booting Linux on physical CPU 0x0000000000 [0x410fd083]"
    echo "Linux version 6.8.0-1017-raspi (buildd@bos03-arm64-012) (aarch64-linux-gnu-gcc-13 (Ubuntu 13.2.0-23ubuntu4) 13.2.0, GNU ld (GNU Binutils for Ubuntu) 2.42) #18-Ubuntu SMP PREEMPT_DYNAMIC Fri Oct 31 10:00:00 UTC 2026 (Ubuntu 6.8.0-1017.18-raspi 6.8.12)"
    echo "KASLR enabled"; b=$((b + 1))
  done
  echo "usb 1-1.3: new high-speed USB device number 4 using xhci_hcd"
  while [ "$u" -lt "${PC_UV:-0}" ]; do
    echo "hwmon hwmon1: Undervoltage detected!"; echo "eth0: Link is Up - 1Gbps/Full - flow control rx/tx"; u=$((u + 1))
  done
  echo "EXT4-fs (mmcblk0p2): re-mounted 3f2a. Quota mode: none."
  exit 0
fi
if [ -n "$until" ] && [ -z "$since" ] && [ "$rev" = 1 ] && [ "$n" = 1 ] && [ "$out" = short-unix ]; then
  [ "${PC_GARBLE:-0}" = 1 ] && { echo "1793990000.1 hub kernel: a"; echo "1793990001.1 hub kernel: b"; echo "1793990002.1 hub kernel: c"; exit 0; }
  [ "${PC_COVER:-1}" = 1 ] && echo "1793999990.123456 hub kernel: Freeing unused kernel memory: 1024K"
  exit 0
fi
exit 0
